# ─── App ────────────────────────────────────────────────────
APP_ENV=production
HTTP_ADDR=:8080
LOG_LEVEL=info

# ─── Database ───────────────────────────────────────────────
# Inside Docker Compose the host is the service name, not localhost.
DATABASE_URL=postgres://isntustup:isntustup@postgres:5432/isntustup?sslmode=disable
POSTGRES_USER=isntustup
POSTGRES_PASSWORD=isntustup
POSTGRES_DB=isntustup

# ─── History ────────────────────────────────────────────────
# Raw samples exist to be rolled up; the daily buckets are what the page reads.
RAW_RESULT_RETENTION_DAYS=14
DAILY_RETENTION_DAYS=400
# How often raw samples are aggregated into the hourly and daily tables. The
# strips read those tables, so this also governs how soon a fresh deploy shows
# past history. The hour currently in progress is read live, so "right now" is
# never stale regardless of this setting. Pruning stays hourly.
ROLLUP_INTERVAL=5m
HISTORY_DAYS=90
# The hourly strip is the page's default view — one box per hour, for "is it
# broken right now". Max 168 (one week).
HISTORY_HOURS=24
HOURLY_RETENTION_DAYS=30
# Days are bucketed in this zone, so a bar labelled Sep 7 covers the day a
# reader in Taiwan actually lived through rather than a UTC slice of two.
DISPLAY_TIMEZONE=Asia/Taipei

# ─── NTUST SSO ──────────────────────────────────────────────
NTUST_SSO_BASE_URL=https://ssoam2.ntust.edu.tw
NTUST_SSO_ENABLED=true
# Leave blank to run structural checks only (the service still starts, and the
# SSO rows explain that no credentials are configured).
# Confirm these work before starting the scheduler:  make verify-sso
NTUST_SSO_USERNAME=
NTUST_SSO_PASSWORD=

# ─── Lockout guard ──────────────────────────────────────────
# NTUST Moodle bans an account after roughly ten failed logins. These bounds
# are the only thing standing between an NTUST outage and a locked account.
SSO_BREAKER_FAILURE_THRESHOLD=2
SSO_BREAKER_BACKOFF_INITIAL=1h
SSO_BREAKER_BACKOFF_MAX=12h
SSO_MAX_LOGIN_ATTEMPTS_PER_DAY=24

# ─── Moodle ─────────────────────────────────────────────────
MOODLE_BASE_URL=https://moodle2.ntust.edu.tw
MOODLE_SITE_INTERVAL=60s
MOODLE_SSO_STRUCTURAL_INTERVAL=5m
MOODLE_SSO_LOGIN_INTERVAL=1h

# ─── Course selection ───────────────────────────────────────
COURSESELECTION_BASE_URL=https://courseselection.ntust.edu.tw
COURSESELECTION_PROBE_PATH=/ChooseList/D01/D01
COURSESELECTION_SITE_INTERVAL=60s
COURSESELECTION_SSO_STRUCTURAL_INTERVAL=5m
COURSESELECTION_SSO_LOGIN_INTERVAL=1h

# ─── WebMail ────────────────────────────────────────────────
# Mail2000 on NTUST's own server. It does NOT use ssoam2 — it has its own
# login, protected by a CAPTCHA, so there is no credentialed check here.
# The login-page check asserts the CGI renders a usable form, which catches
# "Apache is up but the mail backend is dead".
MAIL_BASE_URL=https://mail.ntust.edu.tw
MAIL_LOGIN_PATH=/cgi-bin/login?index=1
MAIL_SITE_INTERVAL=60s
MAIL_LOGIN_PAGE_INTERVAL=5m

# Mail delivery (MX) check. OFF by default: many hosting providers block
# outbound port 25, which would report NTUST as down for reasons that have
# nothing to do with NTUST. Turn it on only if you have verified port 25 is
# reachable from wherever this runs.
MAIL_SMTP_CHECK_ENABLED=false
MAIL_SMTP_HOSTS=mg1.ntust.edu.tw:25,mg2.ntust.edu.tw:25
MAIL_SMTP_INTERVAL=5m

# ─── Course query ───────────────────────────────────────────
QUERYCOURSE_SEMESTERS_URL=https://querycourse.ntust.edu.tw/QueryCourse/api/semestersinfo
QUERYCOURSE_INTERVAL=5m

# ─── TigerDuck backend ──────────────────────────────────────
TIGERDUCK_BASE_URL=https://api.tigerduck.app
TIGERDUCK_V3_PROBE_PATH=/health
TIGERDUCK_INTERVAL=60s

# ─── HTTP client ────────────────────────────────────────────
PROBE_TIMEOUT=15s
# The NTUST edge serves an anti-bot challenge to generic browser UAs, which
# breaks the SSO redirect chain. This UA is on its allow-list.
MOODLE_USER_AGENT="Mozilla/5.0 (iPhone; CPU iPhone OS 18_7 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Mobile/15E148 MoodleMobile 5.1.1 (51100)"

# ─── Public API ─────────────────────────────────────────────
API_RATE_LIMIT_PER_MINUTE=60
API_RATE_LIMIT_BURST=20
API_CACHE_MAX_AGE=30s
# Only peers inside these ranges may set X-Forwarded-For. Leave blank when the
# service is exposed directly: trusting the header unconditionally lets any
# client forge its identity and bypass the rate limiter entirely.
TRUSTED_PROXY_CIDRS=
